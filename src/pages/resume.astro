---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeContent from '../components/ResumeContent.astro';
import { AUTHOR } from '../consts';
import { resumeData } from '../data/resume';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resumeData.name,
  jobTitle: 'Full-Stack Engineer',
  description: resumeData.summary.replace(/<[^>]*>/g, ''),
  url: 'https://adamlacasse.dev',
  sameAs: [resumeData.github, resumeData.linkedin],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Atkinson',
    addressRegion: 'NH',
    addressCountry: 'US',
  },
  knowsAbout: [
    'TypeScript',
    'React',
    'Node.js',
    'Python',
    'Java',
    'PostgreSQL',
    'AWS',
    'Web Architecture',
    'API Design',
    'Software Engineering',
    'Full-Stack Development',
    'Product Engineering',
    'People & Talent Platforms',
    'Applied AI',
    'LLM Integration',
  ],
};
---

<BaseLayout
  title={`Resume - ${AUTHOR}`}
  description="Full-stack engineer focused on enterprise platforms, architecture, and applied AI. Current work includes RMIS modernization supporting ~$4B in annual premium."
  contentWidth="wide"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="resume-page">
    <section class="resume-hero" aria-labelledby="resume-title">
      <div class="hero-copy">
        <p class="eyebrow">{resumeData.signature}</p>
        <h1 id="resume-title">{resumeData.name}</h1>
        <p class="headline">{resumeData.headline}</p>
        <p class="positioning">{resumeData.positioning}</p>

        <div class="hero-actions" aria-label="Resume actions">
          <a href="/resume/pdf" target="_blank" class="resume-button primary"
            >Open ATS/PDF version</a
          >
          <a href={`mailto:${resumeData.email}`} class="resume-button secondary">Email Adam</a>
        </div>
      </div>

      <aside class="contact-panel" aria-label="Contact information">
        <dl>
          <div>
            <dt>Location</dt>
            <dd>{resumeData.location}</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd>{resumeData.phone}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${resumeData.email}`}>{resumeData.email}</a></dd>
          </div>
          <div>
            <dt>Web</dt>
            <dd>
              <a href={`https://${resumeData.website}`} target="_blank" rel="noopener noreferrer"
                >{resumeData.website}</a
              >
            </dd>
          </div>
          <div class="contact-links">
            <dt>Profiles</dt>
            <dd>
              <a href={resumeData.github} target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href={resumeData.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </dd>
          </div>
        </dl>
      </aside>
    </section>

    <section class="impact-strip" aria-label="Selected impact">
      {
        resumeData.impactMetrics.map((metric) => (
          <article class="impact-card">
            <p class="metric-value">{metric.value}</p>
            <h2>{metric.label}</h2>
            <p>{metric.detail}</p>
          </article>
        ))
      }
    </section>

    <section class="resume-section resume-split">
      <div class="section-heading">
        <p class="section-kicker">Positioning</p>
        <h2>Experienced business fluency and platform delivery</h2>
        <p>
          Senior engineering ownership, enterprise-scale systems, and prior business leadership.
          That makes this resume less about tool exposure and more about turning messy operational
          domains into software people can trust.
        </p>
      </div>

      <div class="proof-grid">
        {
          resumeData.proofPoints.map((point) => (
            <article class="proof-card">
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section">
      <div class="section-heading compact">
        <p class="section-kicker">Core capabilities</p>
        <h2>What I do every day</h2>
      </div>

      <div class="capability-grid">
        {
          resumeData.skills.map((skill) => (
            <article class="capability-card">
              <h3>{skill.category}</h3>
              <p>{skill.items}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section resume-split">
      <div class="section-heading">
        <p class="section-kicker">Proof trail</p>
        <h2>Public projects that show the same instincts</h2>
        <p>
          The production work is enterprise and private. The public work shows the same bias toward
          explicit domain models, low-noise workflows, and systems that stay understandable as they
          grow.
        </p>
        <a class="text-link" href="/projects">View all projects</a>
      </div>

      <div class="portfolio-list">
        {
          resumeData.portfolioProof.map((project) => (
            <article class="portfolio-item">
              <div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>
              {project.href && (
                <a href={project.href} target="_blank" rel="noopener noreferrer">
                  {project.linkLabel ?? 'Open'}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section detail-section">
      <div class="section-heading compact">
        <p class="section-kicker">Full resume</p>
        <h2>Experience, education, and operating themes</h2>
      </div>

      <div class="resume-detail">
        <ResumeContent includeSummary={false} includeSkills={false} />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .resume-page {
    --resume-text: #111827;
    --resume-muted: #475467;
    --resume-subtle: #667085;
    --resume-border: #d0d5dd;
    --resume-panel: #ffffff;
    --resume-soft: #f8fafc;
    --resume-accent: #1d4ed8;
    --resume-accent-strong: #123c8c;
    --resume-accent-alt: #047857;
    --resume-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);

    max-width: 1120px;
    margin: 0 auto;
    color: var(--resume-text);
  }

  :global(html[data-theme='dark']) .resume-page {
    --resume-text: #f8fafc;
    --resume-muted: #cbd5e1;
    --resume-subtle: #94a3b8;
    --resume-border: #334155;
    --resume-panel: #111827;
    --resume-soft: #0f172a;
    --resume-accent: #60a5fa;
    --resume-accent-strong: #93c5fd;
    --resume-accent-alt: #34d399;
    --resume-shadow: 0 16px 44px rgba(0, 0, 0, 0.26);
  }

  .resume-page :global(a) {
    color: var(--resume-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .resume-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: 3rem;
    align-items: start;
    padding: 1rem 0 1.75rem;
    border-bottom: 1px solid var(--resume-border);
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.75rem;
    color: var(--resume-accent-alt);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .resume-hero h1 {
    margin: 0;
    color: var(--resume-text);
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 0.95;
  }

  .headline {
    margin: 1rem 0 0;
    color: var(--resume-muted);
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .positioning {
    max-width: 760px;
    margin: 1rem 0 0;
    color: var(--resume-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .resume-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--resume-border);
    border-radius: 8px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .resume-button.primary {
    border-color: var(--resume-accent);
    background: var(--resume-accent);
    color: #ffffff;
  }

  .resume-button.secondary {
    background: transparent;
    color: var(--resume-accent-strong);
  }

  .contact-panel {
    padding-left: 1.25rem;
    border-left: 3px solid var(--resume-accent);
  }

  .contact-panel dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .contact-panel div {
    min-width: 0;
  }

  .contact-panel dt {
    margin-bottom: 0.15rem;
    color: var(--resume-subtle);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .contact-panel dd {
    margin: 0;
    color: var(--resume-text);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .contact-links dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .impact-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 2.5rem;
  }

  .impact-card,
  .proof-card,
  .capability-card,
  .portfolio-item {
    border: 1px solid var(--resume-border);
    border-radius: 8px;
    background: var(--resume-panel);
    box-shadow: var(--resume-shadow);
  }

  .impact-card {
    padding: 1.1rem;
  }

  .metric-value {
    margin: 0 0 0.55rem;
    color: var(--resume-accent);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
  }

  .impact-card h2,
  .proof-card h3,
  .capability-card h3,
  .portfolio-item h3 {
    margin: 0;
    color: var(--resume-text);
    font-size: 1rem;
    line-height: 1.25;
  }

  .impact-card p,
  .proof-card p,
  .capability-card p,
  .portfolio-item p,
  .section-heading p {
    color: var(--resume-muted);
    line-height: 1.6;
  }

  .impact-card p:last-child,
  .proof-card p:last-child,
  .capability-card p:last-child,
  .portfolio-item p:last-child,
  .section-heading p:last-child {
    margin-bottom: 0;
  }

  .resume-section {
    padding: 2.75rem 0;
    border-top: 1px solid var(--resume-border);
  }

  .resume-section:first-of-type {
    border-top: none;
  }

  .resume-split {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: 2.25rem;
    align-items: start;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--resume-text);
    font-size: clamp(1.8rem, 3vw, 2.75rem);
    line-height: 1.05;
  }

  .section-heading p:not(.section-kicker) {
    margin-top: 1rem;
    font-size: 1rem;
  }

  .section-heading.compact {
    max-width: 760px;
    margin-bottom: 1.25rem;
  }

  .proof-grid,
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .proof-card,
  .capability-card {
    padding: 1rem;
  }

  .proof-card h3,
  .capability-card h3,
  .portfolio-item h3 {
    margin-bottom: 0.45rem;
  }

  .portfolio-list {
    display: grid;
    gap: 0.85rem;
  }

  .portfolio-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
  }

  .portfolio-item a,
  .text-link {
    font-weight: 700;
    white-space: nowrap;
  }

  .text-link {
    display: inline-flex;
    margin-top: 1rem;
  }

  .detail-section {
    padding-bottom: 0;
  }

  .resume-detail {
    padding-top: 0.5rem;
  }

  .resume-detail :global(.title) {
    color: var(--resume-text);
  }

  .resume-detail :global(.subtitle),
  .resume-detail :global(.has-text-grey),
  .resume-detail :global(.has-text-grey-light),
  .resume-detail :global(.has-text-grey-dark) {
    color: var(--resume-muted) !important;
  }

  .resume-detail :global(article) {
    padding: 0 0 1.25rem;
    border-bottom: 1px solid var(--resume-border);
  }

  .resume-detail :global(article:last-of-type) {
    border-bottom: none;
  }

  .resume-detail :global(li) {
    color: var(--resume-muted);
  }

  .resume-detail :global(strong) {
    color: var(--resume-text);
  }

  @media screen and (max-width: 900px) {
    .resume-hero,
    .resume-split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .contact-panel {
      padding: 1rem 0 0;
      border-top: 3px solid var(--resume-accent);
      border-left: none;
    }

    .contact-panel dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .impact-strip,
    .proof-grid,
    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 620px) {
    .resume-hero {
      padding-top: 0.5rem;
    }

    .resume-hero h1 {
      font-size: 2.85rem;
    }

    .headline {
      font-size: 1.08rem;
    }

    .positioning {
      font-size: 1rem;
    }

    .contact-panel dl,
    .impact-strip,
    .proof-grid,
    .capability-grid,
    .portfolio-item {
      grid-template-columns: 1fr;
    }

    .portfolio-item a {
      white-space: normal;
    }
  }
</style>
