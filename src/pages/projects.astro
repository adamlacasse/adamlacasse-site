---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../consts';

const projects = [
  {
    name: 'Freq Show!',
    description:
      'Music discovery built around metadata relationships, discographies, credits, and search paths that make side-player exploration easier to follow.',
    href: 'https://freq-show.adamlacasse.dev',
    repo: 'https://github.com/adamlacasse/freq-show',
    status: 'Live',
  },
  {
    name: 'North Flow',
    description:
      'Small check-in app designed around explicit data modeling, durable constraints, and a narrow domain that can evolve without accumulating workflow noise.',
    href: 'https://northflow.adamlacasse.dev',
    repo: 'https://github.com/adamlacasse/northflow',
    status: 'Work in progress',
  },
  {
    name: 'Organizize',
    description:
      'Inventory platform with product tracking, intake/outtake transactions, role-based access, and guardrails for keeping operational state consistent.',
    href: 'https://organizize.adamlacasse.dev',
    repo: 'https://github.com/adamlacasse/organizize',
    status: 'Work in progress',
  },
  {
    name: 'Stacked Deck',
    description:
      'Trivia-night companion that separates game flow from the physical board, with simple state management for draws, categories, answers, and table pacing.',
    href: 'https://stacked-deck.adamlacasse.dev',
    repo: 'https://github.com/adamlacasse/stacked-deck',
    status: 'Live',
  },
];
---

<style>
  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .card-content {
    flex: 1;
  }
</style>

<BaseLayout title={`Projects - ${AUTHOR}`} contentWidth="narrow">
  <h1 class="title is-2">Projects</h1>
  <p class="subtitle">A living list. The hub stays stable; projects can come and go.</p>

  <div class="columns is-multiline">
    {
      projects.map((p) => (
        <div class="column is-half">
          <div class="card">
            <div class="card-content">
              <div class="level">
                <div class="level-left">
                  <h2 class="title is-4">{p.name}</h2>
                </div>
                <div class="level-right">
                  <span class="tag is-success is-light">{p.status}</span>
                </div>
              </div>
              <p>{p.description}</p>
            </div>
            <footer class="card-footer">
              <a href={p.href} class="card-footer-item">
                Live →
              </a>
              <a href={p.repo} target="_blank" rel="noreferrer" class="card-footer-item">
                Repo →
              </a>
            </footer>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
