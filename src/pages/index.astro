---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../consts';
---

<BaseLayout title={AUTHOR}>
  <section class="hero is-medium">
    <div class="hero-body">
      <h1 class="title is-1">Hi, I'm Adam 👋</h1>
      <p class="subtitle is-4">
        I'm a software engineer who spent most of his career on "the business side." For nearly two
        decades I ran finance and operations teams - the people who turned messy problems into
        systems that held up. In 2018, I changed careers to start building those systems myself.
      </p>
      <p class="subtitle is-5">
        Today I'm a senior engineer working on enterprise platforms used by 40,000+ people, one
        course away from an M.S. in Computer Science (AI concentration), and shipping side projects
        in between. I value collaboration, clear communication, and teams built on trust rather than
        internal competition.
      </p>
      <p class="subtitle is-6 has-text-grey">Open to conversations about interesting work.</p>

      <div class="buttons">
        <a href="/about" class="button is-link">About me →</a>
        <a href="/now" class="button is-link is-light">What I'm up to now →</a>
        <a href="/projects" class="button is-link is-light">Projects →</a>
      </div>
    </div>
  </section>
</BaseLayout>
