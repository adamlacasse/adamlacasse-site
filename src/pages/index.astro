---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../consts';
---

<BaseLayout title={AUTHOR}>
  <style>
    .box {
      height: 100%;
    }
  </style>
  <section class="hero is-medium">
    <div class="hero-body">
      <h1 class="title is-1">Hi, I'm Adam 👋</h1>
      <p class="subtitle is-4">
        I'm a senior full stack software engineer with a business background. I focus on building
        software that solves real life problems. I value collaboration, clear communication, and
        teams built on trust over competition.
      </p>

      <div class="buttons">
        <a href="/projects" class="button is-link">Explore projects →</a>
        <a href="/blog" class="button is-link is-light">Read blog →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="title is-3 mb-5">Featured</h2>

    <div class="columns is-multiline">
      <div class="column is-half-tablet is-one-quarter-widescreen">
        <div class="box">
          <h3 class="title is-5">Freq Show!</h3>
          <p>A music-nerd app for deep artist/album/song discovery.</p>
          <a href="https://freq-show.adamlacasse.dev" class="button is-small is-link is-light mt-3">
            freq-show.adamlacasse.dev →
          </a>
        </div>
      </div>

      <div class="column is-half-tablet is-one-quarter-widescreen">
        <div class="box">
          <h4 class="title is-6 has-text-centered">🚧 Work In Progress 🚧</h4>
          <h3 class="title is-5">NorthFlow</h3>
          <p>A mindfulness/gratitude check-in project.</p>
          <a href="https://northflow.adamlacasse.dev" class="button is-small is-link is-light mt-3">
            northflow.adamlacasse.dev →
          </a>
        </div>
      </div>

      <div class="column is-half-tablet is-one-quarter-widescreen">
        <div class="box">
          <h4 class="title is-6 has-text-centered">🚧 Work In Progress 🚧</h4>
          <h3 class="title is-5">Organizize</h3>
          <p>An inventory management tool.</p>
          <a
            href="https://organizize.adamlacasse.dev"
            class="button is-small is-link is-light mt-3"
          >
            organizize.adamlacasse.dev →
          </a>
        </div>
      </div>

      <div class="column is-half-tablet is-one-quarter-widescreen">
        <div class="box">
          <h3 class="title is-5">Stacked Deck</h3>
          <p>
            A digital companion for trivia nights — draw cards, pick categories, reveal answers,
            keep the board physical.
          </p>
          <a
            href="https://stacked-deck.adamlacasse.dev"
            class="button is-small is-link is-light mt-3"
          >
            stacked-deck.adamlacasse.dev →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
