---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
import { profilePageStructuredData, websiteStructuredData } from '../seo';

const description =
  'Adam LaCasse is a senior full-stack engineer building enterprise platforms, applied AI tools, and durable software for complex operations.';
---

<BaseLayout
  title={SITE_TITLE}
  description={description}
  structuredData={[websiteStructuredData, profilePageStructuredData('/', description)]}
>
  <section class="hero home-hero">
    <div class="hero-body">
      <p class="greeting-eyebrow">👋 Hi, I'm Adam. Who's your favorite 1960s bass player?</p>
      <h1 class="title is-1">{AUTHOR}</h1>
      <p class="subtitle is-3">
        Senior full-stack engineer for enterprise platforms and applied AI.
      </p>
      <p class="subtitle is-4">
        I build enterprise software shaped by two decades in finance and operations, using a simple
        but powerful approach: identify the real constraint, simplify around it, and make the system
        easy to trust.
      </p>
      <p class="subtitle is-5">
        Today I work on large-scale platforms at a Fortune 100 insurer, including a risk-management
        information system (RMIS) supporting ~$4B in annual premium, and People & Talent tools used
        by 40,000+ international employees. I recently completed my M.S. in Computer Science
        with an AI concentration. I value collaboration, clear communication, and teams built on
        trust rather than internal competition.
      </p>
      <p class="subtitle is-6 has-text-grey">Open to conversations about interesting work.</p>

      <div class="buttons">
        <a href="/about" class="button is-link">About me →</a>
        <a href="/now" class="button is-link is-light">What I'm up to now →</a>
        <a href="/projects" class="button is-link is-light">Projects →</a>
        <a href="/resume" class="button is-link is-light">Résumé →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .greeting-eyebrow {
    color: var(--bulma-text-weak);
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .greeting-eyebrow + .title {
    margin-top: 0;
  }

  .home-hero .hero-body {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  @media screen and (max-width: 768px) {
    .home-hero .hero-body {
      padding-top: 3rem;
      padding-bottom: 4rem;
    }
  }
</style>
