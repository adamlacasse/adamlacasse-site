---
// ATS-optimized resume page for print/PDF export
// Use browser print (Cmd/Ctrl+P) to save as PDF
import { resumeData } from '../../data/resume';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Adam LaCasse - Resume</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell,
          sans-serif;
        line-height: 1.5;
        color: #000;
        background: #fff;
      }

      @media screen {
        body {
          background: #c8c8c8;
          padding: 2.5rem 1.5rem;
          min-height: 100vh;
        }

        body > div {
          background: #fff;
          max-width: 850px;
          margin: 0 auto;
          padding: 0.75in;
          box-shadow:
            0 2px 8px rgba(0, 0, 0, 0.15),
            0 8px 32px rgba(0, 0, 0, 0.12);
        }
      }

      @page {
        size: letter;
        margin: 0.5in;
      }

      @media print {
        body {
          margin: 0;
          padding: 0;
          font-size: 10.5px;
          line-height: 1.4;
        }

        a {
          color: #000;
          text-decoration: none;
        }

        section {
          break-inside: avoid-page;
          margin-bottom: 10pt;
        }

        h2 {
          break-after: avoid-page;
        }

        .role {
          break-inside: avoid-page;
        }
      }

      header {
        margin-bottom: 1.25rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #000;
      }

      .eyebrow {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #047857;
        margin-bottom: 0.35rem;
      }

      h1 {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 0.2rem;
      }

      .headline {
        font-size: 13px;
        font-weight: 600;
        color: #1d4ed8;
        margin-bottom: 0.5rem;
      }

      .positioning {
        font-size: 11px;
        color: #333;
        margin-bottom: 0.75rem;
        max-width: 760px;
      }

      header .contact-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        font-size: 11px;
        color: #333;
      }

      header span {
        display: flex;
        align-items: center;
      }

      header a {
        color: #000;
        text-decoration: none;
      }

      header a:hover {
        text-decoration: underline;
      }

      main {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
      }

      section {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        border-left: 3px solid #000;
        padding-left: 1rem;
      }

      h2 {
        font-size: 13px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #000;
        margin-bottom: 0.4rem;
      }

      h3 {
        font-size: 12px;
        font-weight: bold;
        margin-bottom: 0.2rem;
        color: #000;
      }

      p {
        font-size: 11px;
        color: #333;
        margin-bottom: 0.4rem;
      }

      ul {
        list-style: disc;
        padding-left: 1.1rem;
        font-size: 11px;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      li {
        margin-bottom: 0;
        color: #333;
      }

      strong {
        font-weight: bold;
        color: #000;
      }

      .impact-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.5rem;
        padding-left: 0;
        border-left: none;
      }

      .impact-card {
        border: 1px solid #d0d5dd;
        border-radius: 4px;
        padding: 0.55rem 0.65rem;
      }

      .impact-value {
        font-size: 16px;
        font-weight: 800;
        color: #1d4ed8;
        line-height: 1.1;
        margin-bottom: 0.15rem;
      }

      .impact-label {
        font-size: 10.5px;
        font-weight: 700;
        color: #000;
        margin-bottom: 0.15rem;
        text-transform: none;
        letter-spacing: 0;
      }

      .impact-detail {
        font-size: 9.5px;
        color: #555;
        line-height: 1.35;
        margin: 0;
      }

      .role {
        margin-bottom: 0.4rem;
      }

      .role-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.4rem;
      }

      .role-title {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .role-subtitle {
        font-size: 11px;
        color: #555;
        margin: 0;
      }

      .role-dates {
        color: #555;
        font-size: 11px;
        white-space: nowrap;
      }

      .tech {
        color: #444;
        font-size: 11px;
        margin-top: 0.4rem;
      }

      li.sub-bullet {
        margin-left: 1rem;
        list-style-type: circle;
      }

      .portfolio-list {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .portfolio-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: baseline;
      }

      .portfolio-item h3 {
        margin: 0 0 0.1rem;
      }

      .portfolio-item p {
        margin: 0;
        font-size: 11px;
      }

      .portfolio-item .portfolio-link {
        font-size: 10.5px;
        font-weight: 600;
        white-space: nowrap;
      }

      .education-item {
        margin-bottom: 0.35rem;
      }

      .education-item:last-child {
        margin-bottom: 0;
      }

      .education-note {
        font-size: 10.5px;
        color: #555;
        margin-top: 0.15rem;
      }

      .footer-info {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        font-size: 11px;
      }

      .footer-info div {
        display: flex;
        gap: 0.5rem;
      }

      .footer-info a {
        color: #000;
        text-decoration: none;
      }

      .footer-info a:hover {
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <div>
      <header>
        <p class="eyebrow">{resumeData.signature}</p>
        <h1>{resumeData.name}</h1>
        <p class="headline">{resumeData.headline}</p>
        <p class="positioning">{resumeData.positioning}</p>

        <div class="contact-row">
          <span>{resumeData.location}</span>
          <span>•</span>
          <span>{resumeData.phone}</span>
          <span>•</span>
          <span><a href={`mailto:${resumeData.email}`}>{resumeData.email}</a></span>
          <span>•</span>
          <span
            ><a href={`https://${resumeData.website}`} target="_blank" rel="noopener noreferrer"
              >{resumeData.website}</a
            ></span
          >
          <span>•</span>
          <span
            ><a href={resumeData.github} target="_blank" rel="noopener noreferrer">GitHub</a></span
          >
          <span>•</span>
          <span
            ><a href={resumeData.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a
            ></span
          >
        </div>
      </header>

      <main>
        <section class="impact-strip" aria-label="Selected impact">
          {
            resumeData.impactMetrics.map((metric) => (
              <div class="impact-card">
                <div class="impact-value">{metric.value}</div>
                <div class="impact-label">{metric.label}</div>
                <p class="impact-detail">{metric.detail}</p>
              </div>
            ))
          }
        </section>

        <section>
          <h2>Summary</h2>
          <p set:html={resumeData.summary} />
        </section>

        <section>
          <h2>Core Skills</h2>
          <ul>
            {
              resumeData.skills.map((skill) => (
                <li>
                  <strong>{skill.category}:</strong> {skill.items}
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>Experience</h2>

          {
            resumeData.experience.map((role) => (
              <div class="role">
                <div class="role-header">
                  <div class="role-title">
                    <h3>
                      {role.company} - {role.title}
                    </h3>
                    {role.subtitle && <p class="role-subtitle">{role.subtitle}</p>}
                  </div>
                  <div class="role-dates">{role.dates}</div>
                </div>

                <ul>
                  {role.achievements.map((achievement) => (
                    <li
                      class={achievement.startsWith('<strong>') ? '' : 'sub-bullet'}
                      set:html={achievement}
                    />
                  ))}
                </ul>

                {role.tech && (
                  <p class="tech">
                    <strong>Tech:</strong> {role.tech}
                  </p>
                )}
              </div>
            ))
          }
        </section>

        <section>
          <h2>Selected Personal Projects</h2>
          <div class="portfolio-list">
            {
              resumeData.portfolioProof.map((project) => (
                <div class="portfolio-item">
                  <div>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                  </div>
                  {project.href && (
                    <a
                      class="portfolio-link"
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.href.replace(/^https?:\/\//, '')}
                    </a>
                  )}
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <h2>Education</h2>
          {
            resumeData.education.map((edu) => (
              <div class="education-item">
                <div>
                  <strong>{edu.degree}</strong> - {edu.school}
                  {edu.date && <span style="color: #555;"> • {edu.date}</span>}
                </div>
                {edu.note && <p class="education-note">{edu.note}</p>}
              </div>
            ))
          }
        </section>

        <section>
          <div class="footer-info">
            <div>
              <strong>Daily:</strong>
              <span>{resumeData.dailyTech}</span>
            </div>
            <div>
              <strong>Project:</strong>
              <span>{resumeData.projectTech}</span>
            </div>
            <div>
              <strong>Portfolio:</strong>
              <span><a href={`https://${resumeData.website}`}>{resumeData.website}</a></span>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
