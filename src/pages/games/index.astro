---
import { AUTHOR } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const description = 'Fun and games, from the mind of Adam LaCasse.';
---

<BaseLayout title={`Games - ${AUTHOR}`} description={description} contentWidth="narrow">
  <section class="games-index">
    <h1>Tiny gamer in my head</h1>
    <p>
      Randomness, happenstance, tomfoolery, & funitude...<br />
      We gotta fart around somehow, don't we?
    </p>
    <div class="game-list">
      <a class="game-card" href="/games/absurdle">
        <span class="game-card__preview" aria-hidden="true">
          <span>A</span><span>B</span><span>S</span><span>U</span><span>R</span><span>D</span><span
            >L</span
          ><span>E</span>
        </span>
        <span class="game-card__body">
          <strong>Absurdle</strong>
          <span
            >A Wordle-style word game with duplicate-letter scoring, seeded share links, hard mode,
            stats, and keyboard play.</span
          >
        </span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .games-index {
    display: grid;
    gap: 1rem;
  }

  .game-list {
    display: grid;
    gap: 1rem;
  }

  .game-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    border: 1px solid #d0d5dd;
    border-radius: 0.5rem;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .game-card:hover {
    border-color: #2f8f46;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .game-card__preview {
    display: grid;
    grid-template-columns: repeat(5, 1.8rem);
    gap: 0.25rem;
  }

  .game-card__preview span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 0.25rem;
    background: #2f8f46;
    color: #fff;
    font-weight: 700;
  }

  .game-card__preview span:nth-child(2),
  .game-card__preview span:nth-child(4) {
    background: #c79a14;
    color: #111827;
  }

  .game-card__preview span:nth-child(5) {
    background: #6b7280;
  }

  .game-card__body {
    display: grid;
    gap: 0.25rem;
  }

  .game-card__body span {
    color: #4b5563;
  }

  :global(html[data-theme='dark']) .game-card {
    border-color: #334155;
  }

  :global(html[data-theme='dark']) .game-card:hover {
    border-color: #39a85a;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  }

  :global(html[data-theme='dark']) .game-card__body span {
    color: #cbd5e1;
  }

  @media (max-width: 520px) {
    .game-card {
      grid-template-columns: 1fr;
    }
  }
</style>
