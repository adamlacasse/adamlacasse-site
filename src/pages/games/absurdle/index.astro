---
import './style.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Absurdle</title>
  </head>
  <body>
    <div class="app">
      <header>
        <h1>Absurdle</h1>
        <small
          >Like <a href="https://www.nytimes.com/games/wordle/index.html">Wordle</a>, but
          wicked more awesome.</small
        >
      </header>
      <div class="settings">
        <label
          >Word length <input
            class="settings__length"
            type="number"
            min="3"
            max="8"
            value="5"
          /></label
        >
        <label
          >Guesses <input
            class="settings__rounds"
            type="number"
            min="3"
            max="10"
            value="6"
          /></label
        >
        <button class="button--new-game" type="button">New Game</button>
      </div>
      <div class="board"></div>
      <div class="feedback"></div>
      <div class="keyboard"></div>
    </div>
    <script>
      import './app.js';
    </script>
  </body>
</html>
